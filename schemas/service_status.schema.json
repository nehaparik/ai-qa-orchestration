{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceStatus",
  "description": "The response body for GET /services/vpn/status (BR04) in the Northstar Services demo dataset.",
  "type": "object",
  "required": ["service", "status", "updated_at"],
  "additionalProperties": true,
  "properties": {
    "service": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["operational", "degraded", "outage"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "message": {
      "type": "string"
    }
  }
}
